DATABASE_URL="file:./prisma/dev.db"

# Email settings (uncomment and fill one of the options below to enable sending emails)
# Option A: Gmail (use an App Password if your account has 2FA enabled)
# GMAIL_USER="your-email@gmail.com"
# GMAIL_PASS=""your-app-password"

# Option B: Generic SMTP
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="smtp-user@example.com"
# SMTP_PASS="smtp-password"

# Optional: override From address
# EMAIL_FROM="no-reply@yourdomain.com"

# JWT secret (change for production)
# JWT_SECRET="supersecret"
DATABASE_URL="mongodb://localhost:27017/pizzahub"
# Or for MongoDB Atlas:
# DATABASE_URL="mongodb+srv://<user>:<pass>@cluster0.mongodb.net/pizzahub?retryWrites=true&w=majority"
JWT_SECRET="supersecretkey"
PORT=4000
CORS_ORIGIN=http://localhost:3000
